#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        vector<int> v(3);
        cin >> v[0] >> v[1] >> v[2];
        int rounds = 0;
        while (true) {
            sort(v.begin(), v.end());
            if (v[0] == v[1] || v[1] == v[2]) {
                break;
            }
            v[0]++;
            v[2]--;
            rounds++;
        }

        cout << rounds << "\n";
    }

    return 0;
}